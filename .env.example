# Copy this file to .env and adjust as needed.
# `.env` is gitignored; only this example file is tracked.
# `bun run setup` (added in a later task) will generate real secrets for local dev.

# --- Database ---
# Postgres is exposed on host port 5433 (not the default 5432) to avoid
# clashing with a Postgres instance you may already be running locally.
# docker-compose (TASK-004) must publish the service on this same port,
# and the API's env.ts (TASK-005) must default DATABASE_URL to match.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/forge

POSTGRES_DB=forge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Auth ---
# Placeholder only — replaced by `bun run setup` when that script exists.
JWT_SECRET=change-me-in-setup

# --- API ---
PORT=3000
# Comma-separated allowlist of origins permitted by CORS (TASK-006). Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Local Docker Compose web origin appended by docker-compose.yml.
WEB_ORIGIN=http://localhost:8080

# --- Web ---
# Optional local Vite dev fallback only. Docker/k3s web containers use runtime
# API_URL to generate /config.js instead of baking this into the JS bundle.
VITE_API_URL=http://localhost:3000
API_URL=http://localhost:3000
