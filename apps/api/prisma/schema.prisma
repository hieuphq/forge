generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  pm
  worker
}

enum ProjectStatus {
  active
  archived
}

enum ExpenseCategory {
  material
  labor
  equipment
  other
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  username     String    @unique
  name         String?
  role         UserRole  @default(worker)
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  expenses     Expense[] @relation("ExpenseCreator")

  @@map("users")
}

model Project {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  estimate  Decimal       @db.Decimal(12, 2)
  status    ProjectStatus @default(active)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  expenses  Expense[]

  @@map("projects")
}

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  createdById String          @map("created_by_user_id") @db.Uuid
  vendor      String
  category    ExpenseCategory
  entryDate   DateTime        @map("entry_date") @db.Date
  note        String?
  subtotal    Decimal         @db.Decimal(12, 2)
  tax         Decimal         @db.Decimal(12, 2)
  fee         Decimal         @db.Decimal(12, 2)
  totalAmount Decimal         @map("total_amount") @db.Decimal(12, 2)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(3)
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       ExpenseItem[]
  attachments Attachment[]

  @@index([projectId, deletedAt])
  @@map("expenses")
}

model ExpenseItem {
  id          String  @id @default(uuid()) @db.Uuid
  expenseId   String  @map("expense_id") @db.Uuid
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@map("expense_items")
}

model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  expenseId   String   @map("expense_id") @db.Uuid
  filename    String
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  storageKey  String   @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@map("attachments")
}
