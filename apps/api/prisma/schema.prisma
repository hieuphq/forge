generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ExampleItem {
  id        String   @id @db.Uuid
  title     String
  dueDate   DateTime @map("due_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("example_items")
}
